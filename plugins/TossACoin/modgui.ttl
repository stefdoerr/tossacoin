@prefix lv2:    <http://lv2plug.in/ns/lv2core#> .
@prefix modgui: <http://moddevices.com/ns/modgui#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .

<http://tossacoin.local/plugins/tossacoin>
    modgui:gui [
        modgui:resourcesDirectory <modgui> ;
        modgui:iconTemplate       <modgui/icon-tossacoin.html> ;
        modgui:stylesheet         <modgui/stylesheet-tossacoin.css> ;
        modgui:javascript         <modgui/script-tossacoin.js> ;
        # Beginner PDF manual — when declared, mod-ui shows a "documentation"
        # button in the plugin info dialog. The Makefile's modgui target
        # copies docs/manual/<plugin>-manual.pdf into the bundle under this
        # FIXED name, so renaming the plugin can't break the reference.
        modgui:documentation      <modgui/manual.pdf> ;
        # Screenshot + thumbnail are REQUIRED, not optional: MOD Desktop's
        # plugin scanner segfaults at startup when a modgui omits them (see
        # "Screenshots — REQUIRED" in INSTRUCTIONS.md). The shipped PNGs are
        # labelled placeholders — replace them with real captures from inside
        # MOD Desktop / MOD-UI once the pedal layout is final.
        modgui:screenshot         <modgui/screenshot-tossacoin.png> ;
        modgui:thumbnail          <modgui/thumbnail-tossacoin.png> ;

        # Mustache tokens MOD-UI substitutes at render time. `brand` and
        # `label` are the strings shown on the pedal frame; `model` and
        # `panel` pick built-in skins (see MOD-UI's pedals.css); `color`
        # / `knob` pick built-in palettes and knob sprites — or you can
        # override them with the custom CSS / sprite in this directory.
        modgui:brand "Stefan" ;
        modgui:label "Toss a Coin" ;
        # `model` + `panel` + `color` + `knob` pick MOD-UI's built-in
        # skins for the pedal frame and knobs. Swap any of these strings
        # to retheme — see MOD-UI's pedals.css / knobs.css for the full
        # list of palettes ("boxy", "rounded"; "1-knob"..."6-knob";
        # "wood1"-"wood4", "metal1"-"metal3"; "gold", "yellow", "red", …).
        modgui:model "boxy" ;
        modgui:panel "1-knob" ;
        modgui:color "wood3" ;

        # Every LV2 port the modgui binds to must be listed here. Symbols
        # must match the `lv2:symbol` strings in the generated <plugin>.ttl
        # (which come from initParameter()'s `parameter.symbol` field).
        modgui:port [
            lv2:index 0 ;
            lv2:symbol "sensitivity" ;
            lv2:name "Sensitivity"
        ] ;
        modgui:port [
            lv2:index 1 ;
            lv2:symbol "bounce" ;
            lv2:name "Bounce"
        ] ;
        modgui:port [
            lv2:index 2 ;
            lv2:symbol "height" ;
            lv2:name "Height"
        ] ;
        modgui:port [
            lv2:index 3 ;
            lv2:symbol "pitch" ;
            lv2:name "Pitch"
        ] ;
        modgui:port [
            lv2:index 4 ;
            lv2:symbol "glitch" ;
            lv2:name "Glitch"
        ] ;
        modgui:port [
            lv2:index 5 ;
            lv2:symbol "level" ;
            lv2:name "Level"
        ] ;
        modgui:port [
            lv2:index 6 ;
            lv2:symbol "steps" ;
            lv2:name "Steps"
        ] ;
        modgui:port [
            lv2:index 7 ;
            lv2:symbol "sound" ;
            lv2:name "Sound"
        ] ;
        modgui:port [
            lv2:index 8 ;
            lv2:symbol "reverse" ;
            lv2:name "Reverse"
        ]
    ] .
